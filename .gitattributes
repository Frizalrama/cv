# Treat binary assets as binary (no line-ending conversion)
*.pdf   binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.ico   binary
# Text web files: normalize to LF in the repo
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.webmanifest text eol=lf
